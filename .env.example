# Funnel Labs - Environment Configuration Example

VITE_APP_TITLE="Funnel Labs — D2C Growth & Experimentation"
VITE_APP_ENV="development" # "development" | "staging" | "production"
VITE_APP_VERSION="1.0.0"
VITE_APP_URL="http://localhost:5173"

# Supabase Configuration (Get from Supabase Project Settings -> API)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-publishable-key"

# Secret Key (Used ONLY by server/migration seed scripts - NEVER expose in client bundle)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key"

# Error Monitoring (Sentry-Ready)
VITE_SENTRY_DSN="" # e.g. "https://xxxx@o1234.ingest.sentry.io/5678"
VITE_SENTRY_TRACES_SAMPLE_RATE="0.2"
SENTRY_DSN="" # Server-side Sentry DSN

# Feature Flags
VITE_ENABLE_ANALYTICS_EXPORT="true"
VITE_ENABLE_AUDIT_LOGS="false"

# ------------------------------------------------------------------------------
# Real Data Integrations & OAuth (Kept 100% Server-Side - Never Expose to Browser)
# ------------------------------------------------------------------------------

# Token Encryption Key for AES-256-GCM (Hex-encoded 32-byte key or passphrase)
INTEGRATION_ENCRYPTION_KEY="replace-with-secure-32-byte-hex-or-secret-passphrase"

# Set to "true" to use built-in mocked provider adapters for local development without live merchant keys
USE_MOCK_INTEGRATIONS="true"

# Shopify OAuth App Configuration (from Shopify Partners -> Apps)
SHOPIFY_CLIENT_ID="your-shopify-app-client-id"
SHOPIFY_CLIENT_SECRET="your-shopify-app-client-secret"
SHOPIFY_REDIRECT_URI="http://localhost:5173/api/integrations/oauth/callback?provider=shopify"

# Meta Ads & Instagram OAuth Configuration (from Meta Developers -> Apps)
META_APP_ID="your-meta-app-id"
META_APP_SECRET="your-meta-app-secret"
META_REDIRECT_URI="http://localhost:5173/api/integrations/oauth/callback?provider=meta"
